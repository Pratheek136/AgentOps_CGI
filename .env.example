# --- Runtime ---
# local (now) | docker (TODO, see README)
RUNTIME=local
SHOP_PORT=5000
BACKEND_PORT=8000
DASHBOARD_PORT=5173

# --- LLM provider ---
# Suggested models (Oct 2026): GEMINI_MODEL=gemini-3.8-flash, GROK_MODEL=grok-4.7
# gemini | grok | replay
LLM_PROVIDER=replay
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-model-id-here
XAI_API_KEY=your-xai-key-here
GROK_MODEL=grok-model-id-here
RECORD_REPLAYS=false
# On-call policy: for memory incidents restart first, verify, then fix the root cause (true|false)
MEMORY_RESTART_FIRST=true

# --- Agent limits ---
VERIFY_WINDOW_S=60
APPROVAL_TIMEOUT_S=600
MAX_STEPS=15
MAX_GATED_ACTIONS=3
MAX_PATCHES=2
AGENT_BUDGET_S=600

# --- Demo ---
TRAFFIC_RPS=3
DEMO_MODE=true
AUTO_CLOSE_S=120

# --- Optional ---
SLACK_WEBHOOK_URL=
